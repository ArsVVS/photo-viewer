<Window x:Class="PhotoExplorer.Wpf.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Width="720" Height="640" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Таблица «клавиша – действие» -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Закрыть" Width="100" HorizontalAlignment="Right"
                Margin="16,8,16,16" IsCancel="True" IsDefault="True" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="Главное окно" />
                <ItemsControl x:Name="MainKeys" ItemTemplate="{StaticResource RowTemplate}" />

                <TextBlock Style="{StaticResource Header}" Text="Полноэкранный просмотр" />
                <ItemsControl x:Name="ViewerKeys" ItemTemplate="{StaticResource RowTemplate}" />

                <TextBlock Style="{StaticResource Header}" Text="Командная строка (photos.exe)" />
                <ItemsControl x:Name="CliCommands" ItemTemplate="{StaticResource RowTemplate}" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Общая опция --cache &lt;путь&gt; – работать с другой базой кеша. Коды возврата: 0 – успех, 1 – ошибка аргументов, 2 – ошибка файла или папки." />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Запуск программы с параметром: PhotoExplorer.Wpf.exe D:\Photos – открыть папку; PhotoExplorer.Wpf.exe D:\Photos\img.jpg – открыть папку и сразу показать файл на весь экран." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
