<Window x:Class="PhotoExplorer.Wpf.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Black"
        KeyDown="Window_KeyDown">
    <Grid x:Name="ViewArea" Background="Black" ClipToBounds="True" SizeChanged="ViewArea_SizeChanged"
          MouseWheel="ViewArea_MouseWheel" MouseLeftButtonDown="ViewArea_MouseLeftButtonDown"
          MouseMove="ViewArea_MouseMove" MouseLeftButtonUp="ViewArea_MouseLeftButtonUp">
        <Canvas>
            <Image x:Name="PhotoImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>

        <!-- Панель с информацией и EXIF (клавиша I) -->
        <Border x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Background="#CC000000" CornerRadius="4" Padding="12,8" Visibility="Collapsed"
                TextElement.FontSize="14">
            <StackPanel>
                <TextBlock x:Name="InfoPosition" Foreground="Gray" Margin="0,0,0,6" />
                <ItemsControl x:Name="InfoList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="DarkGray" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" MaxWidth="360"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Подсказка о состоянии слайд-шоу -->
        <Border x:Name="SlideShowBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                Background="#AA000000" CornerRadius="4" Padding="10,6" Visibility="Collapsed">
            <TextBlock x:Name="SlideShowText" Foreground="White" FontSize="14" />
        </Border>

        <!-- Сообщение, если файл не открылся -->
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="18" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed" Text="Не удалось открыть файл" />
    </Grid>
</Window>
